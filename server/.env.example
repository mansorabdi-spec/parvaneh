# Server
PORT=4001

# SQL Server connection
DB_SERVER=localhost
# If using a named instance like HOST\SQL2022, you can either put it in DB_SERVER or set DB_INSTANCE=SQL2022
# DB_INSTANCE=
DB_DATABASE=LicenseDB
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_CERT=true

# JWT settings
JWT_SECRET=please_change_me
JWT_EXPIRES_IN=7d

# PC-POS HTTP (Asanpardakht CSV). The terminal is the HTTP server.
# Port comes from the terminal's own PC-POS HTTP setting. The vendor sample is 17000.
# Port 80 is the wrong service on most terminals and the amount never appears.
# These are used only until an address is saved from the kiosk screen.
PCPOS_HOST=192.168.1.50
PCPOS_PORT=17000
# The terminal answers only after the customer finishes on the device. Minimum used by the server is 180000.
PCPOS_TIMEOUT_MS=180000
PCPOS_APPLICATION_ID=9999999999999999

# روی سرور اصلی، اگر کارتخوان در شبکه سرور نیست، مقدار زیر را ۱ بگذارید.
# کلید را طولانی و محرمانه انتخاب کنید. همان کلید روی رایانه کیوسک هم هست.
PCPOS_USE_BRIDGE=0
PCPOS_BRIDGE_KEY=

# آدرس سامانه و کلید مشترک روی رایانه کیوسک است، داخل پوشه kiosk-bridge.
# آن فایل فقط دو خط دارد و رمز پایگاه داده در آن نیست.
